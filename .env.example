# Copy to .env.local and fill in values (never commit .env.local).

# Supabase Postgres (required for migrate, seed, and live catalog)
DATABASE_URL=
DIRECT_URL=

# Optional Supabase project URL/keys (app DB access is server-side Drizzle only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Auth0 (@auth0/nextjs-auth0 v4)
AUTH0_SECRET=
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
APP_BASE_URL=http://localhost:3000
ADMIN_AUTH0_SUBS=

# AI (keep false until Gemini slice is ready)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_ENABLED=false

# Mapbox
MAPBOX_TOKEN=pk.eyJ1IjoiZ29xd2luIiwiYSI6ImNtdzZ0dXBzNzAxdTIzMHBwc3c0Y3lhdWEifQ
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1IjoiZ29xd2luIiwiYSI6ImNtdzZ0dXBzNzAxdTIzMHBwc3c0Y3lhdWEifQ
